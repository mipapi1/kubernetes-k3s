# Targets outside the chart's defaults (nodes, kubelet, kube-state-metrics, CoreDNS,
# API server). vmagent picks up every VM*Scrape object in the cluster.
#
# Proxmox: pve-exporter asks the Proxmox API (read-only token) for the whole cluster:
# nodes, VMs, storage, backups, replication.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: pve-exporter
  namespace: monitoring
spec:
  replicas: 1
  selector:
    matchLabels: {app: pve-exporter}
  template:
    metadata:
      labels: {app: pve-exporter}
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsUser: 101
        runAsGroup: 101
        runAsNonRoot: true
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: pve-exporter
          image: {{ monitoring_pve_exporter_image }}
          env:
            # Proxmox uses its self-signed certificates on :8006
            - {name: PVE_VERIFY_SSL, value: "false"}
          envFrom:
            - secretRef: {name: pve-exporter}
          ports:
            - {name: http, containerPort: 9221}
          readinessProbe:
            tcpSocket: {port: http}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          resources:
            requests: {cpu: 10m, memory: 48Mi}
            limits: {memory: 128Mi}
          volumeMounts:
            - {name: tmp, mountPath: /tmp}
      volumes:
        - name: tmp
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: pve-exporter
  namespace: monitoring
spec:
  selector: {app: pve-exporter}
  ports:
    - {name: http, port: 9221, targetPort: http}
---
apiVersion: operator.victoriametrics.com/v1beta1
kind: VMStaticScrape
metadata:
  name: proxmox
  namespace: monitoring
spec:
  jobName: proxmox
  targetEndpoints:
    - targets: ["pve-exporter.monitoring.svc:9221"]
      path: /pve
      params:
        target: ["{{ monitoring_pve_target }}"]
        cluster: ["1"]
        node: ["1"]
      # pve-exporter calls the Proxmox API for every scrape; once a minute is plenty
      interval: 60s
      scrapeTimeout: 30s
      relabelConfigs:
        - {targetLabel: instance, replacement: "{{ monitoring_pve_target }}"}
---
# Longhorn: volume health, node/disk space, backups
apiVersion: operator.victoriametrics.com/v1beta1
kind: VMServiceScrape
metadata:
  name: longhorn
  namespace: monitoring
spec:
  namespaceSelector:
    matchNames: [longhorn-system]
  selector:
    matchLabels: {app: longhorn-manager}
  endpoints:
    - port: manager
---
# Longhorn's own NetworkPolicy only lets Longhorn talk to its managers
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: longhorn-manager-metrics
  namespace: longhorn-system
spec:
  podSelector:
    matchLabels: {app: longhorn-manager}
  policyTypes: [Ingress]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels: {kubernetes.io/metadata.name: monitoring}
          podSelector:
            matchLabels: {app.kubernetes.io/name: vmagent}
      ports:
        - {port: 9500, protocol: TCP}
---
# Traefik: requests, response codes and latency per router/service
apiVersion: operator.victoriametrics.com/v1beta1
kind: VMPodScrape
metadata:
  name: traefik
  namespace: monitoring
spec:
  namespaceSelector:
    matchNames: [kube-system]
  selector:
    matchLabels: {app.kubernetes.io/name: traefik}
  podMetricsEndpoints:
    - port: metrics
{% if monitoring_opnsense_node_exporter | bool %}
---
# OPNsense: CPU, memory, interfaces, pf states (plugin os-node_exporter)
apiVersion: operator.victoriametrics.com/v1beta1
kind: VMStaticScrape
metadata:
  name: opnsense
  namespace: monitoring
spec:
  jobName: opnsense
  targetEndpoints:
    - targets: ["{{ monitoring_opnsense_target }}"]
      labels: {nodename: opnsense}
{% endif %}
