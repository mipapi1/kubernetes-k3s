    "y": 6
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "1 - avg by (nodename) (rate(node_cpu_seconds_total{mode=\"idle\",job=\"node-exporter\"}[5m]) * on(instance) group_left(nodename) node_uname_info)",
     "legendFormat": "{{nodename}}",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     },
     "max": 1,
     "min": 0
    },
    "overrides": []
   }
  },
