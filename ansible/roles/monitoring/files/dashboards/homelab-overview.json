  {
   "type": "timeseries",
   "title": "System disk busy",
   "id": 13,
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "description": "Share of time the node's disk (vda: etcd, Longhorn, images) is busy. Near 100% = etcd gets slow and k3s can restart.",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 6
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "rate(node_disk_io_time_seconds_total{device=\"vda\",job=\"node-exporter\"}[5m]) * on(instance) group_left(nodename) node_uname_info",
     "legendFormat": "{{nodename}}",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     },
     "max": 1,
     "min": 0
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "etcd latency (as the API server sees it, p99)",
   "id": 14,
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "description": "Slow etcd = slow or failing cluster. Under 0.1 s is healthy; seconds means disk contention.",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 14
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "histogram_quantile(0.99, sum by (le, instance) (rate(etcd_request_duration_seconds_bucket{job=\"apiserver\"}[5m])))",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
