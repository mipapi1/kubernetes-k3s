  {
   "type": "stat",
   "title": "Alerts firing",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "description": "Warnings and criticals now firing (the ones sent to ntfy/email). Details: Alerting -> Alert rules.",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "count(ALERTS{alertstate=\"firing\",severity=~\"warning|critical\"}) or vector(0)",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "value",
    "orientation": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
